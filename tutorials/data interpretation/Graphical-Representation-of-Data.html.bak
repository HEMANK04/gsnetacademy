    .sidebar::-webkit-scrollbar { width: 5px; }
    .sidebar::-webkit-scrollbar-thumb { background: #dde2ef; border-radius: 8px; }
    .sidebar-title {
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
