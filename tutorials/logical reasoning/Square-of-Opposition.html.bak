<script>
  (function() {

    const BASE_PATH =
      "/tutorials/logical-reasoning/square-of-opposition";

    const links = document.querySelectorAll(".nav-link");
    const cards = document.querySelectorAll(".topic-card");
    const content = document.getElementById("contentArea");
    const sidebarToggle = document.getElementById("sidebar-toggle");


    // Get topic slug from current URL
    function getSlugFromPath() {

      const path = window.location.pathname
        .replace(/\/+$/, "");

      if (path.startsWith(BASE_PATH + "/")) {

        return path
          .substring((BASE_PATH + "/").length)
          .split("/")[0];

      }

      return null;
    }


    // Update browser URL
    function updateUrl(slug, replace = false) {

      const newPath =
        BASE_PATH + "/" + slug;

      if (window.location.pathname !== newPath) {

        if (replace) {

          history.replaceState(
            null,
            "",
            newPath
          );

        } else {

          history.pushState(
            null,
            "",
            newPath
          );

        }

      }
    }


    // Update active sidebar link
    function updateActiveLink(slug) {

      links.forEach(function(link) {

        const href =
          link.getAttribute("href");

        if (!href) return;

        const linkSlug =
          href
            .split("/")
            .filter(Boolean)
            .pop();

        link.classList.toggle(
          "active",
          linkSlug === slug
        );

      });

    }


    // Show selected topic card
    function showCard(
      slug,
      updateHistory = true
    ) {

      cards.forEach(function(card) {

        card.classList.add("hidden");

      });


      const target =
        document.getElementById(slug);


      if (!target) {

        const first = cards[0];

        if (first) {

          first.classList.remove("hidden");

          const firstSlug =
            first.id;

          updateActiveLink(firstSlug);

          updateUrl(
            firstSlug,
            true
          );

        }

        return;
      }


      target.classList.remove("hidden");

      updateActiveLink(slug);


      if (updateHistory) {

        updateUrl(
          slug,
          false
        );

      }


      if (sidebarToggle) {

        sidebarToggle.checked = false;

      }


      if (content) {

        const top =
          content.getBoundingClientRect().top +
          window.pageYOffset -
          10;

        window.scrollTo({

          top: top,

          behavior: "smooth"

        });

      }

    }


    // Sidebar link click
    links.forEach(function(link) {

      link.addEventListener(
        "click",
        function(e) {

          e.preventDefault();


          const href =
            this.getAttribute("href");

          if (!href) return;


          const slug =
            href
              .split("/")
              .filter(Boolean)
              .pop();


          if (!slug) return;


          console.log(
            "Clicked topic:",
            slug
          );


          showCard(
            slug,
            true
          );

        }
      );

    });


    // Initial page load
    function initFromPath() {

      let slug =
        getSlugFromPath();


      if (
        !slug ||
        !document.getElementById(slug)
      ) {

        slug =
          cards[0]?.id ||
          "square-opposition-intro";

      }


      showCard(
        slug,
        false
      );


      updateUrl(
        slug,
        true
      );

    }


    initFromPath();


    // Browser Back / Forward
    window.addEventListener(
      "popstate",
      function() {

        const slug =
          getSlugFromPath();


        if (
          slug &&
          document.getElementById(slug)
        ) {

          showCard(
            slug,
            false
          );

        } else {

          const firstSlug =
            cards[0]?.id ||
            "square-opposition-intro";

          showCard(
            firstSlug,
            false
          );

        }

      }
    );


  })();
</script>
</body>
