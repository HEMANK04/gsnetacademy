<script>
(function() {

  const BASE_PATH =
    "/tutorials/teaching-aptitude/Methods-of-teaching-in-higher-institutions";

  const links = document.querySelectorAll('.nav-link');
  const cards = document.querySelectorAll('.topic-card');
  const content = document.getElementById('contentArea');
  const sidebarToggle = document.getElementById('sidebar-toggle');


  // Get slug from current URL
  function getSlugFromPath() {

    let path = window.location.pathname;

    path = path.replace(/\/+$/, "");

    if (path.startsWith(BASE_PATH + "/")) {

      return path
        .slice((BASE_PATH + "/").length)
        .split("/")[0];

    }

    return null;
  }


  // Update URL
  function updateUrl(slug) {

    const newPath =
      BASE_PATH + "/" + slug;

    if (window.location.pathname !== newPath) {

      history.pushState(
        null,
        "",
        newPath
      );

    }

  }


  // Update active sidebar link
  function updateActiveLink(slug) {

    links.forEach(function(link) {

      const href =
        link.getAttribute("href");

      link.classList.toggle(
        "active",
        href === BASE_PATH + "/" + slug
      );

    });

  }


  // Show selected topic card
  function showCard(slug, updateHistory = true) {

    cards.forEach(function(card) {

      card.classList.add("hidden");

    });


    const target =
      document.getElementById(slug);


    if (target) {

      target.classList.remove("hidden");

      updateActiveLink(slug);

      if (updateHistory) {
        updateUrl(slug);
      }

    }

    else {

      const first = cards[0];

      if (first) {

        first.classList.remove("hidden");

        const firstSlug =
          first.id;

        updateActiveLink(firstSlug);

        if (updateHistory) {
          updateUrl(firstSlug);
        }

      }

    }


    if (sidebarToggle) {
      sidebarToggle.checked = false;
    }

  }


  // Sidebar click
  links.forEach(function(link) {

    link.addEventListener(
      "click",
      function(e) {

        e.preventDefault();


        const href =
          this.getAttribute("href");

        if (!href) return;


        const slug =
          href
            .replace(BASE_PATH + "/", "")
            .split("/")[0];


        if (!slug) return;


        showCard(slug, true);


        if (content) {

          const top =
            content.getBoundingClientRect().top +
            window.pageYOffset -
            10;


          window.scrollTo({

            top: top,
            behavior: "smooth"

          });

        }

      }
    );

  });


  // Page load
  function initFromPath() {

    let slug =
      getSlugFromPath();


    if (
      !slug ||
      !document.getElementById(slug)
    ) {

      slug =
        cards[0]?.id ||
        "meaning-teaching-method";

    }


    showCard(
      slug,
      false
    );


    const expectedPath =
      BASE_PATH + "/" + slug;


    if (
      window.location.pathname !==
      expectedPath
    ) {

      history.replaceState(
        null,
        "",
        expectedPath
      );

    }

  }


  initFromPath();


  // Browser Back / Forward
  window.addEventListener(
    "popstate",
    function() {

      const slug =
        getSlugFromPath();


      if (
        slug &&
        document.getElementById(slug)
      ) {

        showCard(
          slug,
          false
        );

      }

      else {

        const firstSlug =
          cards[0]?.id ||
          "meaning-teaching-method";


        showCard(
          firstSlug,
          false
        );

      }

    }
  );


})();
</script>
</body>
