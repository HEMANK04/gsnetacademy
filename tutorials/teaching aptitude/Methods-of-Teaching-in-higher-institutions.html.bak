<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Methods of Teaching – Full Notes | UGC NET Paper-1</title>
  <meta name="description" content="Complete methods of teaching tutorial: teacher-centred vs learner-centred, offline vs online, synchronous vs asynchronous, MOOCs, SWAYAM, SWAYAM Prabha for UGC NET Paper-1.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@700;800&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; }
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background: #f8f5ee;
      color: #101a3d;
    }
    .h-display { font-family: 'Poppins', sans-serif; font-weight: 800; letter-spacing: -0.01em; }
    .container { max-width: 1360px; margin: 0 auto; padding: 0 20px; }

    .hero {
      background: #0b1330;
      color: #fff;
      position: relative;
      overflow: hidden;
      padding: 28px 0 22px;
    }
    .hero::before {
      content: "";
      position: absolute;
      right: -80px;
      top: -100px;
      width: 300px;
      height: 300px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(232,183,75,0.2), transparent 70%);
    }
    .hero-inner { position: relative; }
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.15);
      padding: 6px 16px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      color: #e8b74b;
    }
    .hero h1 {
      font-size: clamp(28px, 4.2vw, 44px);
      margin: 12px 0 6px;
    }
    .hero p {
      color: rgba(255,255,255,0.78);
      max-width: 680px;
      font-size: 15px;
      line-height: 1.6;
    }

    .layout {
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: 28px;
      padding: 28px 0 50px;
      align-items: start;
    }
    @media (max-width: 980px) {
      .layout { grid-template-columns: 1fr; }
    }

    .sidebar {
      position: sticky;
      top: 16px;
      max-height: calc(100vh - 40px);
      overflow-y: auto;
      background: #fff;
      border: 1px solid rgba(16,26,61,0.08);
      border-radius: 16px;
      padding: 16px 12px;
      box-shadow: 0 6px 24px rgba(16,26,61,0.05);
    }
    .sidebar::-webkit-scrollbar { width: 5px; }
    .sidebar::-webkit-scrollbar-thumb { background: #dde2ef; border-radius: 8px; }
    .sidebar-title {
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: #b9852a;
      padding: 4px 10px 14px;
    }
    .nav-link {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 10px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 600;
      color: #33406b;
      line-height: 1.3;
      transition: 0.1s;
      cursor: pointer;
      text-decoration: none;
    }
    .nav-link:hover { background: #f4f6fc; color: #0b1330; }
    .nav-link.active {
      background: #fdf6e7;
      color: #0b1330;
    }
    .nav-num {
      flex: none;
      width: 22px;
      height: 22px;
      border-radius: 7px;
      background: #e7eaf5;
      color: #5b6690;
      font-size: 11px;
      font-weight: 800;
      display: grid;
      place-items: center;
    }
    .nav-link.active .nav-num {
      background: #e8b74b;
      color: #0b1330;
    }

    #sidebar-toggle { display: none; }
    .mobile-bar { display: none; }
    @media (max-width: 980px) {
      .mobile-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #fff;
        border: 1px solid rgba(16,26,61,0.1);
        border-radius: 12px;
        padding: 12px 16px;
        margin-bottom: 8px;
        font-weight: 800;
        font-size: 13.5px;
        color: #0b1330;
      }
      .sidebar { display: none; position: static; max-height: none; }
      #sidebar-toggle:checked ~ .layout .sidebar { display: block; }
    }

    .content { min-width: 0; }
    .topic-card {
      background: #fff;
      border: 1px solid rgba(16,26,61,0.08);
      border-radius: 16px;
      padding: 20px 20px 16px;
      margin-bottom: 18px;
      scroll-margin-top: 20px;
      display: block;
    }
    .topic-card.hidden { display: none; }
    .sec-head {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 12px;
    }
    .sec-num {
      flex: none;
      width: 34px;
      height: 34px;
      border-radius: 10px;
      background: #0b1330;
      color: #e8b74b;
      font-weight: 800;
      font-size: 14px;
      display: grid;
      place-items: center;
    }
    .sec-head h2 {
      margin: 0;
      font-size: 19px;
      font-weight: 800;
      color: #0b1330;
    }
    .topic-card p {
      font-size: 14.5px;
      line-height: 1.75;
      color: #1a254a;
      margin: 6px 0;
    }
    .bullet-list {
      margin: 8px 0;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 5px;
    }
    .bullet-list li {
      position: relative;
      padding-left: 20px;
      font-size: 14px;
      line-height: 1.6;
      color: #1a254a;
    }
    .bullet-list li::before {
      content: "";
      position: absolute;
      left: 2px;
      top: 9px;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #d9a53a;
    }
    .formula-box {
      background: #0b1330;
      color: #fdeec2;
      font-weight: 700;
      font-size: 13.6px;
      padding: 10px 16px;
      border-radius: 10px;
      margin: 10px 0;
      overflow-x: auto;
      white-space: nowrap;
    }
    .data-table {
      width: 100%;
      border-collapse: collapse;
      margin: 12px 0;
      font-size: 13.6px;
      display: block;
      overflow-x: auto;
    }
    .data-table th, .data-table td {
      border: 1px solid #e7eaf5;
      padding: 8px 12px;
      text-align: left;
      color: #1a254a;
      white-space: normal;
    }
    .data-table th {
      background: #f4f6fc;
      color: #0b1330;
      font-weight: 800;
    }
    .pyq-tag {
      display: inline-block;
      background: #fdf6e7;
      color: #b9852a;
      font-weight: 800;
      font-size: 12px;
      padding: 4px 12px;
      border-radius: 8px;
      margin: 12px 0 6px;
    }
    .answer-box {
      background: #eefaf2;
      border: 1px solid #bfe8cc;
      color: #1a7a4c;
      font-weight: 700;
      font-size: 13.6px;
      padding: 6px 14px;
      border-radius: 9px;
      margin: 6px 0;
    }
    .explain {
      background: #f4f6fc;
      border-radius: 9px;
      padding: 6px 14px;
      font-size: 13.6px;
      color: #1a254a;
    }
    .subtopic {
      padding: 14px 0 6px;
      border-top: 1px dashed #e7eaf5;
    }
    .subtopic:first-of-type { border-top: none; padding-top: 2px; }
    .subhead {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 6px;
    }
    .sub-num {
      flex: none;
      width: 26px;
      height: 26px;
      border-radius: 8px;
      background: #fdf6e7;
      color: #b9852a;
      font-weight: 800;
      font-size: 12px;
      display: grid;
      place-items: center;
    }
    .subhead h3 {
      margin: 0;
      font-size: 15.5px;
      font-weight: 800;
      color: #0b1330;
    }
    .enroll-cta {
      background: #0b1330;
      color: #fff;
      border-radius: 16px;
      padding: 24px 24px;
      margin-top: 20px;
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      align-items: center;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
    }
    .enroll-cta::before {
      content: "";
      position: absolute;
      right: -40px;
      top: -40px;
      width: 160px;
      height: 160px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(232,183,75,0.2), transparent 70%);
    }
    .enroll-cta h3 { margin: 0 0 4px; font-size: 20px; }
    .enroll-cta p { margin: 0; color: rgba(255,255,255,0.75); font-size: 13.5px; max-width: 480px; }
    .btn-gold {
      background: #e8b74b;
      color: #0b1330;
      font-weight: 800;
      padding: 10px 22px;
      border-radius: 10px;
      font-size: 13.5px;
      white-space: nowrap;
      text-decoration: none;
    }
  </style>

