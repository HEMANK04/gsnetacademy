    .data-table {
      width: 100%;
      border-collapse: collapse;
      margin: 12px 0;
      font-size: 13.6px;
      display: block;
      overflow-x: auto;
    }
    .data-table th, .data-table td {
      border: 1px solid #e7eaf5;
      padding: 8px 12px;
      text-align: left;
      color: #1a254a;
      white-space: normal;
    }
    .data-table th {
      background: #f4f6fc;
      color: #0b1330;
      font-weight: 800;
    }
    .pyq-tag {
      display: inline-block;
      background: #fdf6e7;
      color: #b9852a;
