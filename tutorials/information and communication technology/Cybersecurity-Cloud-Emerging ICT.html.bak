      color: #0b1330;
    }
    .nav-num {
      flex: none;
      width: 22px;
      height: 22px;
      border-radius: 7px;
      background: #e7eaf5;
      color: #5b6690;
      font-size: 11px;
      font-weight: 800;
      display: grid;
      place-items: center;
    }
    .nav-link.active .nav-num {
      background: #e8b74b;
      color: #0b1330;
    }

    #sidebar-toggle { display: none; }
    .mobile-bar { display: none; }
    @media (max-width: 980px) {
      .mobile-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #fff;
        border: 1px solid rgba(16,26,61,0.1);
