      color: #b9852a;
      padding: 4px 10px 14px;
    }
    .nav-link {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 10px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 600;
